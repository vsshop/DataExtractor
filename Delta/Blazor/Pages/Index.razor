@page "/process"
@using Delta.Pipeline.Abstracts
@inherits UpdatableComponent
@inject PipelineService service
@inject DataService data
@inject PreloadService preloader
@inject NavigationManager Nav

<div class="index-page">
    <aside class="sidebar">
        <div class="sidebar-header">
            <svg class="icon" viewBox="0 0 24 24">
                <path fill="currentColor" d="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13Z"/>
            </svg>
            <span class="header-text">Таблицы</span>
        </div>
        <nav class="table-list">
            @foreach (var table in preloader.Tables)
            {
                var isSelected = selectedTable?.Id == table.Id;
                <button class="table-item @(isSelected ? "selected" : "")" @onclick="() => SelectTable(table)">
                    <svg class="table-icon" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M5,8V12H11V8H5M13,8V12H19V8H13M5,14V18H11V14H5M13,14V18H19V14H13Z"/>
                    </svg>
                    <span class="table-name">@table.Title</span>
                    @if (isSelected)
                    {
                        <svg class="check-icon" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"/>
                        </svg>
                    }
                </button>
            }
        </nav>
    </aside>

    <main class="content">
        <div class="toolbar">
            <button class="btn-back" @onclick="NavigateToInspector" title="Назад к Inspector">
                <svg viewBox="0 0 24 24">
                    <path fill="currentColor" d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                </svg>
                <span>Назад</span>
            </button>

            <div class="table-info">
                <svg class="table-info-icon" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M5,8V12H11V8H5M13,8V12H19V8H13M5,14V18H11V14H5M13,14V18H19V14H13Z"/>
                </svg>
                <div class="table-info-text">
                    <div class="table-info-name">@(selectedTable?.Title ?? "Таблица не выбрана")</div>
                    <div class="table-info-status">
                        @if (service.Pipelines.Count > 0 && currentIndex < service.Pipelines.Count)
                        {
                            var currentPipeline = service.Pipelines[currentIndex];
                            <span class="status-indicator @(currentPipeline.Enabled ? "active" : "")"></span>
                            <span>@currentPipeline.Title</span>
                        }
                        else
                        {
                            <span>Готово к обработке</span>
                        }
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <button class="btn-save" @onclick="SaveCurrent" title="Сохранить текущую таблицу">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                    </svg>
                    <span>Сохранить</span>
                </button>
                <button class="btn-save-all" @onclick="SaveAll" title="Сохранить все таблицы">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M17,7H22V17H17V19A1,1 0 0,0 18,20H20V22H17.5C16.95,22 16,21.55 16,21C16,21.55 15.05,22 14.5,22H12V20H14A1,1 0 0,0 15,19V5A1,1 0 0,0 14,4H12V2H14.5C15.05,2 16,2.45 16,3C16,2.45 16.95,2 17.5,2H20V4H18A1,1 0 0,0 17,5V7M2,7H13V9H4V15H13V17H2V7M20,9H17V15H20V9Z"/>
                    </svg>
                    <span>Сохранить всё</span>
                </button>
            </div>
        </div>

        @if (ctx is not null)
        {
            <XTable Ctx="ctx"></XTable>
        }

        <div class="pipeline-history-container">
            <div class="pipeline-header">
                <h3>Исторія змін</h3>
            </div>
            <div class="pipeline-navigator">
                <button class="nav-arrow" @onclick="ScrollLeft" disabled="@(!canScrollLeft)">
                    <span>◄</span>
                </button>

                <div class="pipeline-timeline" @ref="timelineRef">
                    <div class="timeline-track">
                        @for (int i = 0; i < service.Pipelines.Count; i++)
                        {
                            var pipeline = service.Pipelines[i];
                            var index = i;
                            var cssClass = index < currentIndex ? "completed" : (index == currentIndex ? "active" : "");
                            var isCompleted = index < currentIndex;
                            <div class="timeline-item @cssClass">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <Tool Pipeline="pipeline" IsCompleted="isCompleted"></Tool>
                                </div>
                                @if (i < service.Pipelines.Count - 1)
                                {
                                    <div class="timeline-connector @(index < currentIndex ? "completed" : "")"></div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <button class="nav-arrow" @onclick="ScrollRight" disabled="@(!canScrollRight)">
                    <span>►</span>
                </button>
            </div>
        </div>
    </main>
</div>

<style>
    .index-page {
        display: flex;
        width: 100%;
        height: 100vh;
        background: linear-gradient(135deg, #f0f4f8 0%, #e8eef5 100%);
        overflow: visible;
    }

    .sidebar {
        width: 380px;
        min-width: 380px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-right: 1px solid rgba(0, 0, 0, 0.06);
        padding: 20px 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 2px 0 16px rgba(0, 0, 0, 0.04);
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 24px;
        color: #5f6368;
        font-size: 14px;
        font-weight: 500;
    }

    .sidebar-header .icon {
        width: 20px;
        height: 20px;
        color: #1a73e8;
    }

    .header-text {
        flex: 1;
    }

    .table-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 0 12px;
        overflow-y: auto;
        flex: 1;
    }

    .table-list::-webkit-scrollbar {
        width: 6px;
    }

    .table-list::-webkit-scrollbar-track {
        background: transparent;
    }

    .table-list::-webkit-scrollbar-thumb {
        background: #dadce0;
        border-radius: 3px;
    }

    .table-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-radius: 24px;
        font-size: 14px;
        color: #3c4043;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .table-item:hover {
        background: #f1f3f4;
    }

    .table-item.selected {
        background: linear-gradient(135deg, rgba(26, 115, 232, 0.1) 0%, rgba(21, 87, 176, 0.12) 100%);
        color: #1a73e8;
        font-weight: 500;
    }

    .table-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .table-item.selected .table-icon {
        color: #1a73e8;
    }

    .table-name {
        flex: 1;
    }

    .check-icon {
        width: 18px;
        height: 18px;
        color: #34a853;
        flex-shrink: 0;
    }

    .content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
        gap: 15px;
    }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 12px;
        padding: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .btn-back,
    .btn-save,
    .btn-save-all {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: transparent;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        color: #5f6368;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .btn-back:hover,
    .btn-save:hover,
    .btn-save-all:hover {
        background: #f1f3f4;
        border-color: rgba(26, 115, 232, 0.2);
        color: #1a73e8;
    }

    .btn-back svg,
    .btn-save svg,
    .btn-save-all svg {
        width: 18px;
        height: 18px;
    }

    .pipeline-history-compact {
        flex: 1;
        min-width: 0;
    }

    .table-info {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .table-info-icon {
        width: 20px;
        height: 20px;
        color: #1a73e8;
        flex-shrink: 0;
    }

    .table-info-text {
        flex: 1;
        min-width: 0;
    }

    .table-info-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: #3c4043;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .table-info-status {
        font-size: 0.75rem;
        color: #5f6368;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
    }

    .status-indicator {
        width: 6px;
        height: 6px;
        background: #dadce0;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .status-indicator.active {
        background: #34a853;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .pipeline-history-container {
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        flex-shrink: 0;
        overflow: visible;
        position: relative;
    }

    .pipeline-header {
        margin-bottom: 8px;
    }

    .pipeline-header h3 {
        color: #3c4043;
        margin: 0;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .pipeline-navigator {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        padding: 0;
        overflow: visible;
    }

    .nav-arrow {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        background: transparent;
        color: #5f6368;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .nav-arrow:hover:not(:disabled) {
        background: #f1f3f4;
        border-color: rgba(26, 115, 232, 0.2);
        color: #1a73e8;
    }

    .nav-arrow:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .pipeline-timeline {
        flex: 1;
        overflow-x: auto;
        overflow-y: visible;
        scroll-behavior: smooth;
        padding: 8px;
    }

    .pipeline-timeline::-webkit-scrollbar {
        height: 4px;
    }

    .pipeline-timeline::-webkit-scrollbar-track {
        background: transparent;
    }

    .pipeline-timeline::-webkit-scrollbar-thumb {
        background: #dadce0;
        border-radius: 2px;
    }

    .pipeline-timeline::-webkit-scrollbar-thumb:hover {
        background: #bdc1c6;
    }

    .timeline-track {
        display: flex;
        align-items: center;
        min-width: min-content;
        padding: 4px 0;
        overflow: visible;
    }

    .timeline-item {
        position: relative;
        display: flex;
        align-items: center;
        flex-shrink: 0;
        overflow: visible;
    }

    .timeline-item.completed .timeline-dot {
        background: #5f6368;
        border-color: #dadce0;
    }

    .timeline-item.completed .timeline-content {
        opacity: 0.6;
    }

    .timeline-item.active .timeline-dot {
        background: #1a73e8;
        border-color: #1a73e8;
        animation: pulse-active 2s ease-in-out infinite;
    }

    @@keyframes pulse-active {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(26, 115, 232, 0.4);
        }
        50% {
            transform: scale(1.3);
            box-shadow: 0 0 0 4px rgba(26, 115, 232, 0);
        }
    }

    .timeline-dot {
        width: 8px;
        height: 8px;
        background: #dadce0;
        border: 2px solid #e8eaed;
        border-radius: 50%;
        position: relative;
        z-index: 2;
        transition: all 0.2s ease;
    }

    .timeline-content {
        padding: 0;
        background: transparent;
        margin-left: 8px;
        transition: opacity 0.2s ease;
        overflow: visible;
    }

    .timeline-connector {
        width: 32px;
        height: 1px;
        background: #e8eaed;
        margin: 0 4px;
        transition: background 0.2s ease;
    }

    .timeline-connector.completed {
        background: #1a73e8;
    }
</style>

@code 
{
    PipelineContext? ctx = null;
    private ElementReference timelineRef;
    private int currentIndex = 0;
    private bool canScrollLeft = false;
    private bool canScrollRight = true;
    private Table? selectedTable = null;

    protected override async Task OnInitializedAsync()
    {
        selectedTable = data.Tables.FirstOrDefault();
        await Rebuild();
        currentIndex = service.Pipelines.Count - 1;
    }

	protected override Task OnUITick() => Rebuild();

	protected override void OnAfterRender(bool firstRender)
	{
		if (service.Pipelines.Count > 0)
		{
			canScrollRight = currentIndex < service.Pipelines.Count - 1;
			canScrollLeft = currentIndex > 0;
		}
	}

	private async Task SelectTable(Table table)
	{
		selectedTable = table;
		await Rebuild();
	}

	private void NavigateToInspector()
	{
		Nav.NavigateTo("/");
	}

	private void ScrollLeft()
	{
		if (currentIndex > 0)
		{
			currentIndex--;
			StateHasChanged();
		}
	}

	private void ScrollRight()
	{
		if (currentIndex < service.Pipelines.Count - 1)
		{
			currentIndex++;
			StateHasChanged();
		}
	}

	public async Task ChangePipline(BasePipeline pipeline)
	{
		pipeline.Switch();
		await Rebuild();
	}

	public async Task Rebuild()
	{
		if (selectedTable != null)
		{
			ctx = PipelineContext.Build(selectedTable);
            await service.InvokeAsync(ctx, currentIndex);
		}
	}

    public async Task SaveCurrent()
	{
	}

    public async Task SaveAll()
	{
	}
}